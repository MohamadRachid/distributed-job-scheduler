# Copy to .env (gitignored) to override defaults locally. docker-compose.yml sets
# these for the control-plane container directly; this file documents every knob
# and seeds agent config for workers.

# --- Passwords (2026-09-07) ---
# docker-compose.yml reads each of these first and falls back to the development
# default shown. PostgreSQL, MinIO and pgAdmin are published on 127.0.0.1 only, so
# the defaults are reachable from the machine running the stack and from nowhere
# else; a deployment that is not a demonstration still changes them here.
# The pgAdmin image writes its passfile from POSTGRES_PASSWORD at build time, so
# after changing it run `docker compose --profile tools build pgadmin`.
POSTGRES_PASSWORD=fyp
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
JWT_SECRET=fyp-dev-jwt-secret-change-in-prod
ADMIN_PASSWORD=fyp-admin

# --- Control plane ---
DATABASE_URL=postgresql+asyncpg://fyp:fyp@postgres:5432/fyp

# Tunables (protocol.md §8). W1 only consumes NODE_TIMEOUT_S (read-time liveness).
# HEARTBEAT_INTERVAL_S and LEASE_TTL_S are read from one place now so the W5
# reaper doesn't introduce new config later.
HEARTBEAT_INTERVAL_S=3
# 60s is the shipped default (ruled 2026-08-29, raised from 15s). docker-compose.yml
# interpolates this variable, so setting it here changes the stack without editing
# compose. The demonstration runs at 15s, set by scripts/stage_demo.ps1 itself.
LEASE_TTL_S=60
NODE_TIMEOUT_S=12

# MinIO — present in the stack from W1, wired into code in W6.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=artifacts

# --- Agent (set on each worker machine) ---
# https, because the control plane has served HTTPS only since 2026-08-22. This
# variable BEATS the agent's own default, so a worker set up by copying this file
# used to get plain http against a TLS-only server -- which does not fail with a
# useful message, it just closes the connection and the agent retries for ever.
# That is the same wrong-default family that emptied the demonstration's opening
# screen and blinded the experiment harness for eight days.
SERVER_URL=https://localhost:8000
# REQUIRED whenever SERVER_URL is https (protocol.md §8): the agent verifies the
# server against THIS authority alone, never the machine's system trust store, and
# refuses to start without it rather than trusting whoever answers. Generate the
# pair with `python scripts/make_certs.py`, which writes certs/ca.pem.
AGENT_CA_CERT=certs/ca.pem
# AGENT_NAME defaults to the machine hostname if unset.
AGENT_NAME=
# Real GPU/RAM probing is a stretch goal; override here for W1.
AGENT_HAS_GPU=false
AGENT_RAM_MB=
AGENT_CAPACITY=
